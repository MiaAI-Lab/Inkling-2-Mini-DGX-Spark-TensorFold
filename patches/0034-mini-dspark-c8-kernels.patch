+/// The most chunks one drafter attention call splits its keys into (the partials' room holds at least this many).
+const attn_parts = 32;
+
+/// TF_INKLING2_DRAFT_ATTN_SPLIT=0: every drafter attention block takes a 1,024-key chunk, as before (8 to 16 blocks a
+/// call on short contexts; a block's serial softmax then bounds the call at ~0.6 ms on the GB10).
+fn attnSplitOn() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TF_INKLING2_DRAFT_ATTN_SPLIT")) |e| e[0] != '0' else true;
+    return S.v.?;
+}
+
+/// TF_INKLING2_DRAFT_ATTN_WARP=0: tf_ink2m_attn (a thread a score, the softmax a thread a query row) instead of
+/// tf_ink2m_attn_w (a warp a query row, the softmax online in registers).
+fn attnWarpOn() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TF_INKLING2_DRAFT_ATTN_WARP")) |e| e[0] != '0' else true;
+    return S.v.?;
+}
+
+/// Keys a drafter attention block takes over [lo, hi]: the smallest of 128, 256, 512 and 1,024 that splits them into
+/// at most attn_parts chunks, so a short context still fills the GPU (the same math a chunk; the merge folds more).
+fn attnChunk(lo: usize, hi: usize) usize {
+    if (!attnSplitOn()) return chunk;
+    var ck: usize = 128;
+    while (ck < chunk and hi / ck - lo / ck + 1 > attn_parts) ck *= 2;
+    return ck;
+}
