+#pragma unroll
+        for (int i = 0; i < 4; ++i) a.po[rh * kD + lane * 4 + i] = o[r][i];
+        if (lane == 0) {
+            a.pml[rh * 2] = m[r];
+            a.pml[rh * 2 + 1] = l[r];
+        }
+    }
+}
