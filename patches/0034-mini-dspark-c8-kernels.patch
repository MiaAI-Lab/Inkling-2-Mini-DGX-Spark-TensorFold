+// tf_ink2m_attn's partials, a warp per query row: lanes over the 128 dims (four each), a 64-key K/V tile in shared
+// memory, the scores by warp_sum and the softmax online in registers. The same partials (unnormalised sums, max,
+// total) for tf_ink2m_merge; the arithmetic order differs from tf_ink2m_attn, so proposals may differ in the last
+// bits (the target verifies them). Eight warps take the 24 query rows of a key head three rows each.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2m_attn_w(AttnArgs a) {
+    using namespace ink2m;
+    constexpr int kT = 64;
+    __shared__ __align__(16) uint16_t sk[kT][kD];
+    __shared__ __align__(16) uint16_t sv[kT][kD];
+    const int j = blockIdx.y, c = a.c0 + blockIdx.x, tid = threadIdx.x, w = tid >> 5, lane = tid & 31;
+    const int g = a.hq / a.hk, nq = a.T * g, nqt = a.T * a.hq;
+    const int k0 = max(a.lo, c * a.ck), k1 = min(a.hi + 1, (c + 1) * a.ck);
+    constexpr int kR = kMaxQ / 8;
+    float q[kR][4], o[kR][4], m[kR], l[kR];
+#pragma unroll
+    for (int r = 0; r < kR; ++r) {
+        const int qi = w + 8 * r;
+        m[r] = -INFINITY;
+        l[r] = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            o[r][i] = 0.0f;
+            q[r][i] = qi < nq ? bf(a.q[(static_cast<size_t>(qi / g) * a.hq + j * g + qi % g) * kD + lane * 4 + i]) : 0.0f;
+        }
+    }
+    for (int kt = k0; kt < k1; kt += kT) {
+        const int nk = min(kT, k1 - kt);
+        for (int idx = tid; idx < nk * (kD / 8); idx += blockDim.x) {
+            const int kk = idx / (kD / 8), part = idx % (kD / 8);
+            const size_t at = (static_cast<size_t>((kt + kk) % a.ring) * a.hk + j) * kD + part * 8;
+            reinterpret_cast<uint4*>(&sk[kk][0])[part] = *reinterpret_cast<const uint4*>(a.kc + at);
+            reinterpret_cast<uint4*>(&sv[kk][0])[part] = *reinterpret_cast<const uint4*>(a.vc + at);
+        }
+        __syncthreads();
+        for (int kk = 0; kk < nk; ++kk) {
+            const uint2 kw = reinterpret_cast<const uint2*>(&sk[kk][0])[lane];
+            const uint2 vw = reinterpret_cast<const uint2*>(&sv[kk][0])[lane];
+            const float kx[4] = {bf(kw.x & 0xFFFFu), bf(kw.x >> 16), bf(kw.y & 0xFFFFu), bf(kw.y >> 16)};
+            const float vx[4] = {bf(vw.x & 0xFFFFu), bf(vw.x >> 16), bf(vw.y & 0xFFFFu), bf(vw.y >> 16)};
+#pragma unroll
+            for (int r = 0; r < kR; ++r) {
+                float s = q[r][0] * kx[0];
+                s += q[r][1] * kx[1];
+                s += q[r][2] * kx[2];
+                s += q[r][3] * kx[3];
+                s = tf_common::warp_sum(s) * a.scale;
+                const float mx = fmaxf(m[r], s);
+                const float al = expf(m[r] - mx), p = expf(s - mx);
+                l[r] = l[r] * al + p;
+#pragma unroll
+                for (int i = 0; i < 4; ++i) o[r][i] = o[r][i] * al + p * vx[i];
+                m[r] = mx;
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < kR; ++r) {
+        const int qi = w + 8 * r;
+        if (qi >= nq) continue;
