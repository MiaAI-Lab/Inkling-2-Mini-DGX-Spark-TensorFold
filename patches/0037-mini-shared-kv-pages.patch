+/// A VMM and driver in host memory for the pages' error paths: which handle each address maps, which handles live,
+/// and failures on demand (CUDA_ERROR_NOT_READY: Driver.check returns it without logging).
+const FakeVmm = struct {
+    const va0: u64 = 1 << 40;
+    const page: u64 = 2 << 20;
+    var maps: [160]u64 = undefined; // per page index (copy addresses past the slots'): the mapped handle (0: unmapped)
+    var live: [256]bool = undefined; // handle -> created and not released
+    var tags: [256]u32 = undefined; // handle -> what its rows hold (a copy carries the source's)
+    var copies: usize = 0;
+    var next: u64 = 1;
+    var fail_create: bool = false;
+    var fail_unmap: bool = false;
+
+    fn reset() void {
+        @memset(&maps, 0);
+        @memset(&live, false);
+        @memset(&tags, 0);
+        copies = 0;
+        next = 1;
+        fail_create = false;
+        fail_unmap = false;
+    }
+    fn index(addr: u64) usize {
+        return @intCast((addr - va0) / page);
+    }
+    fn create(h: *u64, _: usize, _: *const cuda.arena.Vmm.Prop, _: c_ulonglong) callconv(.c) cuda.abi.Result {
+        if (fail_create) return cuda.abi.error_not_ready;
+        h.* = next;
+        live[next] = true;
+        next += 1;
+        return cuda.abi.success;
+    }
+    fn release(h: u64) callconv(.c) cuda.abi.Result {
+        live[h] = false;
+        return cuda.abi.success;
+    }
+    fn map(addr: u64, _: usize, _: usize, h: u64, _: c_ulonglong) callconv(.c) cuda.abi.Result {
+        if (maps[index(addr)] != 0 or !live[h]) return 1;
+        maps[index(addr)] = h;
+        return cuda.abi.success;
+    }
+    fn unmap(addr: u64, _: usize) callconv(.c) cuda.abi.Result {
+        if (fail_unmap) return cuda.abi.error_not_ready;
+        if (maps[index(addr)] == 0) return 1;
+        maps[index(addr)] = 0;
+        return cuda.abi.success;
+    }
+    fn access(_: u64, _: usize, _: *const anyopaque, _: usize) callconv(.c) cuda.abi.Result {
+        return cuda.abi.success;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        return cuda.abi.success;
+    }
+    fn copy(dst: u64, src: u64, _: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        const d = maps[index(dst)];
+        const s = maps[index(src)];
+        if (d == 0 or s == 0) return 1;
+        tags[d] = tags[s];
+        copies += 1;
+        return cuda.abi.success;
+    }
+
+    /// Pages over the fake: 1 visit, 2 slots, 1 key head, 2 pages a plane (4 planes, 8 page addresses).
+    fn open(a: A, d: *cuda.Driver) !*Pages {
+        reset();
+        d.api.cuStreamSynchronize = sync;
+        d.api.cuMemcpyDtoDAsync_v2 = @ptrCast(&copy);
+        var v: cuda.arena.Vmm = undefined;
+        v.api.create = create;
+        v.api.release = release;
+        v.api.map = map;
+        v.api.unmap = unmap;
+        v.api.setAccess = @ptrCast(&access);
+        v.device = 0;
+        v.prop = .{};
+        v.granularity = page;
+        v.va = va0;
+        v.va_len = maps.len * page;
+        const g: Geometry = .{ .visits = 1, .slots = 2, .heads = 1, .ring = 2 * page / row_bytes, .page_bytes = page };
+        const p = try a.create(Pages);
+        const mapped = try a.alloc(?*Page, g.planes() * g.pagesPerPlane());
+        @memset(mapped, null);
+        p.* = .{ .a = a, .d = d, .vmm = v, .g = g, .mapped = mapped, .zero = 0, .read_only = true };
+        p.zero = try p.vmm.allocPhysical(d, page);
+        for (0..mapped.len) |i| try p.mapZero(i);
+        return p;
+    }
+
+    /// Every page address maps what `mapped` says (the zero page for null), and no pooled handle is mapped anywhere.
+    fn consistent(p: *const Pages) !void {
+        for (p.mapped, 0..) |m, i| try std.testing.expectEqual(if (m) |pg| pg.handle else p.zero, maps[i]);
+        for (p.pool[0..p.pooled]) |h| for (maps) |m| try std.testing.expect(m != h);
+    }
+
+    fn close(p: *Pages) void {
+        for (p.mapped) |m| if (m) |pg| pg.release(p);
+        p.a.free(p.mapped);
+        p.a.destroy(p);
+    }
+};
+
+test "shared KV pages: a failed kept-page allocation at release leaves the zero page mapped, not a hole" {
+    const a = std.testing.allocator;
+    var d: cuda.Driver = undefined;
+    const p = try FakeVmm.open(a, &d);
+    defer FakeVmm.close(p);
+    const s: cuda.Stream = .{ .d = &d, .handle = null };
+    try p.ensure(s, 0, 0, 2 * p.g.rowsPerPage()); // slot 0: both pages of both planes its own
+    const snap = try p.snapshot(0, p.g.rowsPerPage()); // a prompt state holds the first page of each plane
+    defer snap.deinit();
+    FakeVmm.fail_create = true; // out of pages: the shared kept page cannot be swapped for a fresh one
+    try p.releaseSlot(s, 0, 1);
+    FakeVmm.fail_create = false;
+    try FakeVmm.consistent(p);
+    // the slot writes again from position 0: the zero page under it turns private as usual
+    try p.ensure(s, 0, 0, 1);
+    try FakeVmm.consistent(p);
+}
+
+test "shared KV pages: a failed unmap at restore keeps the slot's own page mapped and out of the pool" {
+    const a = std.testing.allocator;
+    var d: cuda.Driver = undefined;
+    const p = try FakeVmm.open(a, &d);
+    defer FakeVmm.close(p);
+    const s: cuda.Stream = .{ .d = &d, .handle = null };
+    try p.ensure(s, 0, 0, p.g.rowsPerPage());
+    const snap = try p.snapshot(0, p.g.rowsPerPage());
+    defer snap.deinit();
+    try p.ensure(s, 1, 0, p.g.rowsPerPage()); // slot 1 keeps a first page of its own a plane
+    const pooled = p.pooled;
+    FakeVmm.fail_unmap = true;
+    try std.testing.expectError(error.NotReady, p.restore(s, 1, &snap));
+    FakeVmm.fail_unmap = false;
+    try std.testing.expectEqual(pooled, p.pooled); // nothing recycled while still mapped
+    try FakeVmm.consistent(p);
+    try p.restore(s, 1, &snap); // the driver recovers: the snapshot's pages are mapped, the own ones pooled
+    try FakeVmm.consistent(p);
+    for (0..p.g.slotPlanes()) |j| try std.testing.expectEqual(snap.pages[j], p.mapped[p.g.pageIndex(p.g.slotPlane(1, j), 0)].?);
+}
+
+test "shared KV pages: copy on write gives the writer a copy and leaves the snapshot its page" {
+    const a = std.testing.allocator;
+    var d: cuda.Driver = undefined;
+    const p = try FakeVmm.open(a, &d);
+    defer FakeVmm.close(p);
+    p.share_partial = true; // TF_INKLING2_SNAP_SHARE_PARTIAL: the partly filled first page is shared, not copied
+    const s: cuda.Stream = .{ .d = &d, .handle = null };
+    try p.ensure(s, 0, 0, 100);
+    for (0..p.g.slotPlanes()) |j| FakeVmm.tags[p.mapped[p.g.pageIndex(p.g.slotPlane(0, j), 0)].?.handle] = @intCast(10 + j);
+    const snap = try p.snapshot(0, 100);
+    defer snap.deinit();
+    try std.testing.expectEqual(@as(usize, 1), p.snapPages(100));
+    try std.testing.expectEqual(@as(usize, 0), FakeVmm.copies);
+    // the stream writes on at 100, inside the shared page: it is copied for the slot first
+    try p.ensure(s, 0, 100, 101);
+    try std.testing.expectEqual(p.g.slotPlanes(), FakeVmm.copies);
+    try FakeVmm.consistent(p);
+    for (0..p.g.slotPlanes()) |j| {
+        const mine = p.mapped[p.g.pageIndex(p.g.slotPlane(0, j), 0)].?;
+        try std.testing.expect(mine != snap.pages[j]);
+        try std.testing.expectEqual(@as(u32, @intCast(10 + j)), FakeVmm.tags[mine.handle]); // the rows came along
+        try std.testing.expectEqual(@as(usize, 1), mine.refs.load(.acquire));
+        try std.testing.expect(FakeVmm.live[snap.pages[j].handle]); // the snapshot's page lives on
+    }
+    // a restore into slot 1 shares the page again, and its first write copies it again
+    try p.restore(s, 1, &snap);
+    try FakeVmm.consistent(p);
+    try p.ensure(s, 1, 100, 108);
+    try std.testing.expectEqual(2 * p.g.slotPlanes(), FakeVmm.copies);
+    try FakeVmm.consistent(p);
+    // the slot gives its pages back (none kept): the pool takes them, nothing it holds is still mapped
+    try p.releaseSlot(s, 0, 0);
+    try p.releaseSlot(s, 1, 0);
+    try FakeVmm.consistent(p);
+    try std.testing.expect(p.pooled >= 2 * p.g.slotPlanes());
+}
