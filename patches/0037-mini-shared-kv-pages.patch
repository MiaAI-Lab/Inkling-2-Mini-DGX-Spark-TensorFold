+test "shared KV ledger keeps a drafter's per-stream caches, allocated after the plan, out of the budget" {
+    const kib: u64 = 1 << 10;
+    const pages = .{ .fixed_bytes = 0, .scratch = kib, .token_bytes = 24, .page_tokens = 256, .lookahead = 7 };
+    const loaded = .{ .shared_pages = @as(?@TypeOf(pages), pages) };
+    const o: api.Open = .{ .dir = "", .model_type = "inkling", .lanes = 8 };
+    const room = 200 * kib;
+    const extra = 3 * kib; // a drafter's caches a stream
+    var short: ?Short = null;
+    const in: Inputs = .{ .room = room, .context = 1024, .host_budget = 6 * kib, .host_cache = true };
+    const bare = shared(Cached, loaded, o, in, &short).?;
+    var with = in;
+    with.stream_extra = extra;
+    const p = shared(Cached, loaded, o, with, &short).?;
+    try std.testing.expectEqual(bare.total - 8 * extra, p.total);
+    try std.testing.expectEqual(kib + 8 * extra, p.cost.each.scratch);
+    // everything the plan hands out, the scratch and the drafter's caches fit the room
+    try std.testing.expect(p.total + p.kept.copied + p.cost.each.scratch <= room);
+    // a drafter that leaves no full window is refused, not overcommitted
+    with.stream_extra = room / 8;
+    try std.testing.expectEqual(@as(?Plan, null), shared(Cached, loaded, o, with, &short));
+}
