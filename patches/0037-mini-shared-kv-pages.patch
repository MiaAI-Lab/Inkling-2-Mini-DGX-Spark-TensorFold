+//! Inkling 2 Mini's whole (global) caches on CUDA VMM pages (TF_INKLING2_SHARED_KV=1): the model's own layout, a
+//! visit's K or V at [slots][kv][ring][128] bf16, behind one reserved address range, so every kernel and graph sees
+//! the addresses and strides it always had. Each page is either the shared zero page (mapped read-only: a page no
+//! stream has written yet) or a physical page of its own, made when a forward is about to write its rows (`ensure`).
+//! A prompt snapshot keeps its pages by reference instead of copying them; a later write to a page a snapshot holds
+//! copies that page first (copy on write). Streams therefore hold only the pages their rows reach, and the server's
+//! ledger leases them per request (lanes share one budget instead of each reserving a whole window).
+const std = @import("std");
+const cuda = @import("cuda");
+const A = std.mem.Allocator;
+
+/// Bytes a cached position takes in one K or V plane (a key head's 128 bf16).
+pub const row_bytes = 2 * 128;
+
+/// A slot's window, in positions, rounded up so each plane is whole pages (up to 4 MiB pages).
+pub fn alignContext(context: usize) usize {
+    return std.mem.alignForward(usize, context, (4 << 20) / row_bytes);
+}
+
+pub const Geometry = struct {
+    visits: usize, // whole-cache visits (Mini: 8)
+    slots: usize,
+    heads: usize, // key heads (Mini: 8)
+    ring: usize, // positions a plane holds
+    page_bytes: usize,
+
+    pub fn pagesPerPlane(g: Geometry) usize {
+        return g.ring * row_bytes / g.page_bytes;
+    }
+
+    /// Planes of one slot: each visit's K and V for every key head.
+    pub fn slotPlanes(g: Geometry) usize {
+        return g.visits * 2 * g.heads;
+    }
+
+    pub fn planes(g: Geometry) usize {
+        return g.slotPlanes() * g.slots;
+    }
+
+    pub fn rowsPerPage(g: Geometry) usize {
+        return g.page_bytes / row_bytes;
+    }
+
+    pub fn pagesFor(g: Geometry, rows: usize) usize {
+        return std.math.divCeil(usize, rows, g.rowsPerPage()) catch unreachable;
+    }
+
+    /// The plane of (visit, side, slot, head) in the model's order: visit, then side, then [slots][kv].
+    pub fn plane(g: Geometry, visit: usize, side: usize, slot: usize, head: usize) usize {
+        return ((visit * 2 + side) * g.slots + slot) * g.heads + head;
+    }
+
+    /// The `j`th plane of `slot` (its visits, sides and heads in order).
+    pub fn slotPlane(g: Geometry, slot: usize, j: usize) usize {
+        const head = j % g.heads;
+        const side = (j / g.heads) % 2;
+        const visit = j / (2 * g.heads);
+        return g.plane(visit, side, slot, head);
+    }
+
+    pub fn pageIndex(g: Geometry, p: usize, page: usize) usize {
+        return p * g.pagesPerPlane() + page;
+    }
+
+    /// Device bytes of a slot's pages through `rows` positions (a lease's or a snapshot's charge).
+    pub fn bytesAt(g: Geometry, rows: usize) usize {
+        return g.slotPlanes() * g.pagesFor(rows) * g.page_bytes;
+    }
+};
+
+const Page = struct {
+    handle: u64,
+    refs: std.atomic.Value(usize) = .init(1),
+    // the prompt cache's charge (under Pages.pool_lock): snapshots holding the page, and the one charged for it
+    // (0: none; `orphan`: its charged snapshot was dropped while others still hold it, counted in Pages.orphan_bytes)
+    snaps: u32 = 0,
+    owner: u64 = 0,
+
+    fn retain(p: *Page) void {
+        _ = p.refs.fetchAdd(1, .monotonic);
+    }
+
+    /// The last holder gives the physical page back to `pages` (its pool, else the driver).
+    fn release(page: *Page, pages: *Pages) void {
+        if (page.refs.fetchSub(1, .acq_rel) != 1) return;
+        pages.recycle(page.handle);
+        pages.a.destroy(page);
+    }
+};
+
+/// Released physical pages kept for reuse (no cuMemCreate/cuMemRelease on the serving path), at most this many: they
+/// are charged to the ledger's scratch, beside the zero page.
+pub const pool_cap = 128;
+/// Pages a copy-on-write batch makes private with one stream synchronize (a slot's planes: one page each).
+pub const batch = 128;
+
+/// Page.owner of a page whose charged snapshot is gone while other snapshots still hold it.
+const orphan = std.math.maxInt(u64);
+
+/// A slot's whole pages below `at` positions, held by reference (a prompt snapshot's whole caches; the rows of a partly
+/// filled last page are copied with the state, so a slot never writes into a page a snapshot holds). `charged`: the
+/// bytes of the pages no other snapshot held when it was made (each physical page is charged to one snapshot only).
+pub const Snapshot = struct {
+    from: *Pages,
+    at: usize,
+    pages: []*Page, // slotPlanes x pagesFor(at), plane-major
+    id: u64,
+    charged: usize,
+
+    /// Needs the engine's CUDA context current on the calling thread (a last release may free a physical page).
+    pub fn deinit(s: Snapshot) void {
+        const p = s.from;
+        p.lockPool();
+        for (s.pages) |page| {
+            page.snaps -= 1;
+            if (page.owner == s.id) {
+                if (page.snaps > 0) { // still held by later snapshots: its bytes stay in the budget as spare
+                    page.owner = orphan;
+                    p.orphan_bytes += p.g.page_bytes;
+                } else page.owner = 0;
+            } else if (page.owner == orphan and page.snaps == 0) {
+                page.owner = 0;
+                p.orphan_bytes -= p.g.page_bytes;
+            }
+        }
+        p.unlockPool();
+        for (s.pages) |page| page.release(p);
+        p.a.free(s.pages);
+    }
+};
+
+pub const Pages = struct {
+    a: A,
+    d: *const cuda.Driver,
+    vmm: cuda.arena.Vmm,
+    g: Geometry,
+    mapped: []?*Page, // null: the zero page
+    zero: u64, // the zero page's physical handle
+    read_only: bool, // the zero page is mapped read-only (a stray write faults instead of spreading)
+    pool: [pool_cap]u64 = undefined, // released physical pages kept for reuse
+    pooled: usize = 0,
+    // guards the pool and the cache's charge (snaps, owner, orphan_bytes). A snapshot may be dropped on another thread
+    // than the engine's, but with the engine's CUDA context current: a release past the pool frees physical memory.
+    pool_lock: std.atomic.Value(bool) = .init(false),
+    next_snapshot: u64 = 1,
+    /// Bytes of pages that only snapshots hold whose charged snapshot was dropped: the prompt cache counts them as its
+    /// family's spare storage, so its budget always covers every page a kept state holds.
+    orphan_bytes: usize = 0,
+    /// Pages a plane each slot keeps between its prompts (TF_INKLING2_SLOT_PAGES, default 1: its first 8,192 positions),
+    /// charged to the ledger's scratch; a short prompt then maps nothing.
+    keep: usize = 1,
+    /// TF_INKLING2_SNAP_SHARE_PARTIAL=1 (dev: to exercise copy on write): snapshots hold the partly filled last page too
+    /// instead of copying its rows, so a restored slot's first write copies that page.
+    share_partial: bool = false,
+    trace: bool = false,
+    stats: struct { ns: [3]u64 = @splat(0), calls: [3]u64 = @splat(0), fresh: u64 = 0, copies: u64 = 0, released: u64 = 0 } = .{},
+
+    /// Reserve every plane's addresses and map the zero page under each of its pages.
+    pub fn open(a: A, d: *const cuda.Driver, device: cuda.abi.Device, visits: usize, slots: usize, heads: usize, ring: usize) !*Pages {
+        const p = try a.create(Pages);
+        errdefer a.destroy(p);
+        var vmm = try cuda.arena.Vmm.load(d, device);
+        errdefer vmm.close();
+        const g: Geometry = .{ .visits = visits, .slots = slots, .heads = heads, .ring = ring, .page_bytes = vmm.granularity };
+        if (ring * row_bytes % g.page_bytes != 0) return error.Inkling2PagesUnaligned;
+        const mapped = try a.alloc(?*Page, g.planes() * g.pagesPerPlane());
+        errdefer a.free(mapped);
+        @memset(mapped, null);
+        // `batch` more pages of addresses: the copy targets while pages turn private
+        try vmm.reserveRange((mapped.len + batch) * g.page_bytes);
+        p.* = .{ .a = a, .d = d, .vmm = vmm, .g = g, .mapped = mapped, .zero = 0, .read_only = true };
+        if (std.c.getenv("TF_INKLING2_SLOT_PAGES")) |v| p.keep = @min(g.pagesPerPlane(), std.fmt.parseInt(usize, std.mem.span(v), 10) catch 1);
+        p.trace = if (std.c.getenv("TF_INKLING2_PAGES_TRACE")) |v| v[0] == '1' else false;
+        p.share_partial = if (std.c.getenv("TF_INKLING2_SNAP_SHARE_PARTIAL")) |v| v[0] == '1' else false;
+        p.zero = try p.vmm.allocPhysical(d, g.page_bytes);
+        errdefer p.vmm.freePhysical(p.zero, g.page_bytes);
+        {
+            // clear the zero page through the copy address once
+            const copy_va = p.address(mapped.len);
+            try p.vmm.mapPhysical(d, copy_va, g.page_bytes, p.zero);
+            defer p.vmm.unmapPhysical(d, copy_va, g.page_bytes) catch {};
+            try d.check(d.api.cuMemsetD8_v2(copy_va, 0, g.page_bytes), "clear the Inkling zero page");
+            try d.check(d.api.cuCtxSynchronize(), "clear the Inkling zero page"); // the memset is asynchronous
+        }
+        var done: usize = 0;
+        errdefer for (0..done) |i| p.vmm.unmapPhysical(d, p.address(i), g.page_bytes) catch {};
+        for (0..mapped.len) |i| {
+            try p.mapZero(i);
+            done += 1;
+        }
+        return p;
+    }
+
+    pub fn deinit(p: *Pages) void {
+        // the prompt cache drops its states first (cuda_host_close): spare bytes left here are a charge gone astray
+        if (p.orphan_bytes != 0) std.log.warn("Inkling KV pages: {d} MiB of kept states' pages still charged as spare at close", .{p.orphan_bytes >> 20});
+        _ = p.d.api.cuCtxSynchronize();
+        for (0..p.mapped.len) |i| {
+            p.vmm.unmapPhysical(p.d, p.address(i), p.g.page_bytes) catch {};
+            if (p.mapped[i]) |page| page.release(p);
+        }
+        for (p.pool[0..p.pooled]) |h| p.vmm.freePhysical(h, p.g.page_bytes);
+        p.vmm.freePhysical(p.zero, p.g.page_bytes);
+        p.a.free(p.mapped);
+        p.vmm.close();
+        p.a.destroy(p);
+    }
+
+    /// The model's base address of (visit, side): [slots][kv][ring][128].
+    pub fn base(p: *const Pages, visit: usize, side: usize) u64 {
+        return p.address(p.g.pageIndex(p.g.plane(visit, side, 0, 0), 0));
+    }
+
+    fn address(p: *const Pages, index: usize) u64 {
+        return p.vmm.va + index * p.g.page_bytes;
+    }
+
+    fn mapZero(p: *Pages, index: usize) !void {
+        const at = p.address(index);
+        if (p.read_only) {
+            p.vmm.mapPhysicalAccess(p.d, at, p.g.page_bytes, p.zero, true) catch {
+                // a driver without read-only device mappings: the zero page stays writable (nothing writes it)
+                p.read_only = false;
+                return p.vmm.mapPhysical(p.d, at, p.g.page_bytes, p.zero);
+            };
+            return;
+        }
+        try p.vmm.mapPhysical(p.d, at, p.g.page_bytes, p.zero);
+    }
+
+    pub fn lockPool(p: *Pages) void {
+        while (p.pool_lock.cmpxchgWeak(false, true, .acquire, .monotonic) != null) std.atomic.spinLoopHint();
+    }
+
+    pub fn unlockPool(p: *Pages) void {
+        p.pool_lock.store(false, .release);
+    }
+
+    /// A released physical page: kept in the pool while it has room, else given back to the driver.
+    fn recycle(p: *Pages, handle: u64) void {
+        p.lockPool();
+        if (p.pooled < pool_cap) {
+            p.pool[p.pooled] = handle;
+            p.pooled += 1;
+            p.unlockPool();
+            return;
+        }
+        p.unlockPool();
+        p.vmm.freePhysical(handle, p.g.page_bytes);
+    }
+
+    fn newPage(p: *Pages) !*Page {
+        const page = try p.a.create(Page);
+        errdefer p.a.destroy(page);
+        p.lockPool();
+        const pooled: ?u64 = if (p.pooled > 0) blk: {
+            p.pooled -= 1;
+            break :blk p.pool[p.pooled];
+        } else null;
+        p.unlockPool();
+        page.* = .{ .handle = pooled orelse try p.vmm.allocPhysical(p.d, p.g.page_bytes) };
+        return page;
+    }
+
+    fn temp(p: *const Pages, k: usize) u64 {
+        return p.address(p.mapped.len + k);
+    }
+
+    /// Back each page of `indices` (at most `batch`) with a page of its own. A shared page's rows are copied first (all
+    /// copies queued, then one synchronize); an unwritten one (the zero page) takes a page as it comes, as a cuMemAlloc'd
+    /// cache would: its rows are written before any is read. The stream is idle on entry.
+    fn privatize(p: *Pages, s: cuda.Stream, indices: []const usize) !void {
+        const len = p.g.page_bytes;
+        var news: [batch]*Page = undefined;
+        var copied: [batch]bool = @splat(false); // mapped at its copy address
+        var made: usize = 0;
+        var placed: usize = 0;
+        errdefer {
+            s.synchronize() catch {};
+            for (news[placed..made], copied[placed..made], placed..) |n, c, k| {
+                if (c) p.vmm.unmapPhysical(p.d, p.temp(k), len) catch {};
+                n.release(p);
+            }
+        }
+        var copies: usize = 0;
+        for (indices, 0..) |i, k| {
+            const n = try p.newPage();
+            news[k] = n;
+            made += 1;
+            if (p.mapped[i] == null) continue;
+            try p.vmm.mapPhysical(p.d, p.temp(k), len, n.handle);
+            copied[k] = true;
+            try p.d.check(p.d.api.cuMemcpyDtoDAsync_v2(p.temp(k), p.address(i), len, s.handle), "copy an Inkling KV page");
+            copies += 1;
+        }
+        if (copies > 0) try s.synchronize();
+        for (indices, 0..) |i, k| {
+            if (copied[k]) try p.vmm.unmapPhysical(p.d, p.temp(k), len);
+            copied[k] = false;
+            try p.vmm.unmapPhysical(p.d, p.address(i), len);
+            if (p.mapped[i]) |old| old.release(p); // a shared page: its other holders keep it
+            p.mapped[i] = null;
+            placed += 1; // from here the new page is this index's (or freed below), not the errdefer's
+            p.vmm.mapPhysical(p.d, p.address(i), len, news[k].handle) catch |e| {
+                news[k].release(p);
+                p.mapZero(i) catch {};
+                return e;
+            };
+            p.mapped[i] = news[k];
+        }
+        p.stats.fresh += made;
+        p.stats.copies += copies;
+    }
+
+    /// `slot`'s positions [start, end) are about to be written: each page they reach becomes the slot's own.
+    pub fn ensure(p: *Pages, s: cuda.Stream, slot: usize, start: usize, end: usize) !void {
+        if (start >= end) return;
+        if (end > p.g.ring or slot >= p.g.slots) return error.Inkling2PageRange;
+        const t0 = if (p.trace) clockNs() else 0;
+        defer if (p.trace) p.note(.ensure, t0);
+        const first = start / p.g.rowsPerPage();
+        const last = p.g.pagesFor(end);
+        var due: [batch]usize = undefined;
+        var n_due: usize = 0;
+        var drained = false;
+        for (0..p.g.slotPlanes()) |j| {
+            const pl = p.g.slotPlane(slot, j);
+            for (first..last) |n| {
+                const i = p.g.pageIndex(pl, n);
+                if (p.mapped[i]) |page| if (page.refs.load(.acquire) == 1) continue;
+                if (!drained) {
+                    try s.synchronize(); // nothing may still read a page being replaced
+                    drained = true;
+                }
+                due[n_due] = i;
+                n_due += 1;
+                if (n_due == batch) {
+                    try p.privatize(s, due[0..n_due]);
+                    n_due = 0;
+                }
+            }
+        }
+        if (n_due > 0) try p.privatize(s, due[0..n_due]);
+    }
+
+    /// Give back the pages `slot` holds (its snapshots keep theirs) past its first `keep` a plane; within those, a page
+    /// a snapshot shares is swapped for one of the slot's own, so the next prompt writes its first rows without
+    /// mapping anything (`keep` 0: everything back, as before a restore). The stream is synchronized first.
+    pub fn releaseSlot(p: *Pages, s: cuda.Stream, slot: usize, keep: usize) !void {
+        const t0 = if (p.trace) clockNs() else 0;
+        var drained = false;
+        for (0..p.g.slotPlanes()) |j| {
+            const pl = p.g.slotPlane(slot, j);
+            for (0..p.g.pagesPerPlane()) |n| {
+                const i = p.g.pageIndex(pl, n);
+                const page = p.mapped[i] orelse continue;
+                if (n < keep and page.refs.load(.acquire) == 1) continue; // the slot's own: kept for its next prompt
+                if (!drained) {
+                    try s.synchronize();
+                    drained = true;
+                }
+                try p.vmm.unmapPhysical(p.d, p.address(i), p.g.page_bytes);
+                p.mapped[i] = null;
+                page.release(p);
+                p.stats.released += 1;
+                if (n < keep) {
+                    // a kept page only spares the next prompt a map: without one, the zero page (never an unmapped address)
+                    const fresh = p.newPage() catch {
+                        try p.mapZero(i);
+                        continue;
+                    };
+                    p.vmm.mapPhysical(p.d, p.address(i), p.g.page_bytes, fresh.handle) catch |e| {
+                        fresh.release(p);
+                        try p.mapZero(i);
+                        return e;
+                    };
+                    p.mapped[i] = fresh;
+                    p.stats.fresh += 1;
+                } else try p.mapZero(i);
+            }
+        }
+        if (p.trace) p.note(.release, t0);
+    }
+
+    pub const Stat = enum { ensure, release, restore };
+
+    fn clockNs() u64 {
+        var t: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(.MONOTONIC, &t);
+        return @as(u64, @intCast(t.sec)) * 1_000_000_000 + @as(u64, @intCast(t.nsec));
+    }
+
+    /// TF_INKLING2_PAGES_TRACE=1: wall time and page work by kind, logged every 64 releases.
+    fn note(p: *Pages, kind: Stat, t0: u64) void {
+        const k = @intFromEnum(kind);
+        p.stats.ns[k] += clockNs() - t0;
+        p.stats.calls[k] += 1;
+        if (kind == .release and p.stats.calls[k] % 64 == 0) std.log.info("Inkling KV pages: ensure {d} calls {d:.1} ms, release {d} calls {d:.1} ms, restore {d} calls {d:.1} ms; pages made {d}, copied {d}, released {d}", .{
+            p.stats.calls[0], @as(f64, @floatFromInt(p.stats.ns[0])) / 1e6, p.stats.calls[1], @as(f64, @floatFromInt(p.stats.ns[1])) / 1e6, p.stats.calls[2], @as(f64, @floatFromInt(p.stats.ns[2])) / 1e6, p.stats.fresh, p.stats.copies, p.stats.released,
+        });
+    }
+
+    /// Pages a plane a snapshot at `at` positions holds: the whole ones below it, and the partly filled last one too
+    /// under share_partial.
+    pub fn snapPages(p: *const Pages, at: usize) usize {
+        return if (p.share_partial) p.g.pagesFor(at) else at / p.g.rowsPerPage();
+    }
+
+    /// `slot`'s whole pages below `at` positions, by reference (none for a prompt shorter than a page).
+    pub fn snapshot(p: *Pages, slot: usize, at: usize) !Snapshot {
+        const count = p.snapPages(at);
+        if (count > p.g.pagesPerPlane() or slot >= p.g.slots) return error.Inkling2PageRange;
+        const saved = try p.a.alloc(*Page, p.g.slotPlanes() * count);
+        var held: usize = 0;
+        errdefer {
+            for (saved[0..held]) |page| page.release(p);
+            p.a.free(saved);
+        }
+        for (0..p.g.slotPlanes()) |j| {
+            const pl = p.g.slotPlane(slot, j);
+            for (0..count) |n| {
+                const page = p.mapped[p.g.pageIndex(pl, n)] orelse return error.Inkling2MissingPage;
+                page.retain();
+                saved[held] = page;
+                held += 1;
+            }
+        }
+        // charge each page to the first snapshot that holds it
+        p.lockPool();
+        defer p.unlockPool();
+        const id = p.next_snapshot;
+        p.next_snapshot += 1;
+        var charged: usize = 0;
+        for (saved) |page| {
+            if (page.snaps == 0) {
+                page.owner = id;
+                charged += p.g.page_bytes;
+            }
+            page.snaps += 1;
+        }
+        return .{ .from = p, .at = at, .pages = saved, .id = id, .charged = charged };
+    }
+
+    /// Make `slot` hold `saved`'s whole pages (shared) and, past them, only the pages it keeps of its own (the caller
+    /// copies the partly filled last page's rows into those).
+    pub fn restore(p: *Pages, s: cuda.Stream, slot: usize, saved: *const Snapshot) !void {
+        if (saved.from != p) return error.Inkling2PageRange;
+        const count = p.snapPages(saved.at);
+        if (saved.pages.len != count * p.g.slotPlanes()) return error.Inkling2PageRange;
+        const t0 = if (p.trace) clockNs() else 0;
+        defer if (p.trace) p.note(.restore, t0);
+        try p.releaseSlot(s, slot, p.keep);
+        try s.synchronize();
+        for (0..p.g.slotPlanes()) |j| {
+            const pl = p.g.slotPlane(slot, j);
+            for (0..count) |n| {
+                const i = p.g.pageIndex(pl, n);
+                const page = saved.pages[j * count + n];
+                if (p.mapped[i] == page) continue; // already this snapshot's page
+                // unmapped before a page of the slot's own goes back: a pooled handle is never still mapped here
+                try p.vmm.unmapPhysical(p.d, p.address(i), p.g.page_bytes);
+                if (p.mapped[i]) |own| { // a kept page of the slot's own goes back for the shared one
+                    p.mapped[i] = null;
+                    own.release(p);
+                    p.stats.released += 1;
+                }
+                p.vmm.mapPhysical(p.d, p.address(i), p.g.page_bytes, page.handle) catch |e| {
+                    p.mapZero(i) catch {};
+                    return e;
+                };
+                page.retain();
+                p.mapped[i] = page;
+            }
+        }
+    }
+};
