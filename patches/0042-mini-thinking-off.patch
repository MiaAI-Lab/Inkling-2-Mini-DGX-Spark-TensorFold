@@ -0,0 +1,33 @@
+//! Direct generation starts for thinking-off on the inkling2_loop checkpoint only.
+const std = @import("std");
+const api = @import("engine_api");
+const errors = @import("errors.zig");
+const grammar = @import("grammar.zig");
+const markers = @import("inkling_reply.zig").markers;
+const Server = @import("server.zig").Server;
+const Value = @import("json").Value;
+const Cx = errors.Cx;
+
+pub fn off(srv: *const Server, thinking: bool) bool {
+    return !thinking and srv.text.inkling2_mini and srv.text.vtable.format == .inkling;
+}
+
+/// Text/JSON starts inside content; tools start inside a model header so a function name can follow.
+pub fn textStart(cx: *Cx, tools: []const Value) errors.Refused!bool {
+    return tools.len == 0 or try grammar.spec(cx, cx.template_fields) != null;
+}
+
+pub fn prefix(srv: *Server, cx: *Cx, tools: []const Value, ids: []const u32) errors.Refused![]const u32 {
+    const model = srv.text.tokenId(markers.model) orelse return cx.refuse("Mini direct reply needs a model token");
+    if (!try textStart(cx, tools)) return std.mem.concat(cx.a, u32, &.{ ids, &.{model} });
+    const text = srv.text.tokenId(markers.text) orelse return cx.refuse("Mini direct reply needs a text token");
+    return std.mem.concat(cx.a, u32, &.{ ids, &.{ model, text } });
+}
+
+/// End a free-text answer at its block boundary, before the model can open a second thinking block.
+pub fn finish(srv: *Server, cx: *Cx, tools: []const Value, request: *api.Request) errors.Refused!void {
+    if (!try textStart(cx, tools)) return;
+    const end = srv.text.tokenId(markers.end) orelse return cx.refuse("Mini direct reply needs an end token");
+    if (std.mem.indexOfScalar(u32, request.eos, end) == null)
+        request.eos = try std.mem.concat(cx.a, u32, &.{ request.eos, &.{end} });
+}
