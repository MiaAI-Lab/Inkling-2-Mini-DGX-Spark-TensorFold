+//! Mini-only direct-answer integration through actual request preparation and whole/SSE reply parsing.
+const std = @import("std");
+const api = @import("engine_api");
+const server = @import("root.zig");
+const json = server.json;
+const fixture = @import("inkling_route_test.zig");
+const Conn = @import("http_conn.zig").Conn;
+const t = std.testing;
+const A = std.mem.Allocator;
+
+const Backend = struct {
+    tokens: []const u32,
+    request: ?api.Request = null,
+    committed: usize = 0,
+    fn engine(e: *Backend) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{ .context_window = 4096 };
+    }
+    fn submit(p: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *Backend = @ptrCast(@alignCast(p));
+        e.request = request.*;
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        for (e.tokens) |token| {
+            sink.event(sink.ctx, id, &.{ .tokens = &.{token} });
+            e.committed += 1;
+            if (std.mem.indexOfScalar(u32, request.eos, token) != null) break;
+        }
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+fn run(a: A, mini: bool, stream: bool, raw: bool, fields: []const u8, parts: []const []const u8) !struct { got: fixture.Got, request: api.Request, committed: usize } {
+    var backend: Backend = .{ .tokens = try fixture.script(a, parts) };
+    var text: fixture.Text = .{ .mini = mini };
+    const srv = try server.Server.init(t.allocator, t.io, backend.engine(), text.text(), .{ .served_name = "any-alias", .model_ids = &.{"any-alias"}, .enable_thinking = true, .use_drafts = false }, null);
+    defer srv.deinit();
+    const body = try std.mem.concat(a, u8, &.{ "{\"model\":\"any-alias\",\"max_tokens\":100,", if (raw) "\"prompt\":\"raw\"" else "\"messages\":[{\"role\":\"user\",\"content\":\"Reply briefly.\"}]", ",\"stream\":", if (stream) "true" else "false", fields, "}" });
+    var wire: fixture.Wire = .{ .a = a };
+    var headers = [_]@import("http_conn.zig").Header{.{ .name = "Content-Length", .value = try std.fmt.allocPrint(a, "{d}", .{body.len}) }};
+    var conn: Conn = .{ .fd = -1, .peer = "", .buf = try a.dupe(u8, body), .end = body.len, .gpa = a, .version = "HTTP/1.1", .method = "POST", .path = "", .headers = &headers, .write_hooks = .{ .ctx = &wire, .write = fixture.Wire.write } };
+    @import("openai.zig").post(srv, &conn, a, !raw);
+    const bytes = wire.bytes.items;
+    try t.expect(std.mem.startsWith(u8, bytes, "HTTP/1.1 200 "));
+    var got: fixture.Got = .{};
+    var frames: std.ArrayList([]const u8) = .empty;
+    if (stream) {
+        var at: usize = 0;
+        while (std.mem.indexOfPos(u8, bytes, at, "data: ")) |d| {
+            const end = std.mem.indexOfPos(u8, bytes, d, "\n\n") orelse bytes.len;
+            if (!std.mem.eql(u8, bytes[d + 6 .. end], "[DONE]")) try frames.append(a, bytes[d + 6 .. end]);
+            at = end;
+        }
+    } else try frames.append(a, bytes[(std.mem.indexOf(u8, bytes, "\r\n\r\n") orelse return error.NoBody) + 4 ..]);
+    for (frames.items) |frame| {
+        const choices = ((try json.parse(a, frame)).ok.get("choices") orelse continue).items() orelse continue;
+        if (choices.len > 0) try got.keep(a, choices[0], if (stream) "delta" else "message");
+    }
+    return .{ .got = got, .request = backend.request orelse return error.NotSubmitted, .committed = backend.committed };
+}
+
+const off = ",\"chat_template_kwargs\":{\"enable_thinking\":false},\"reasoning_effort\":\"high\"";
+
+test "Inkling Mini off: actual prompt enters text, first answer ends generation, whole and SSE" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    for ([_]bool{ false, true }) |stream| {
+        const r = try run(arena.allocator(), true, stream, false, off, &.{ "Answer.", "<|end_message|>", "<|message_model|>", "<|content_thinking|>", "Unwanted continuation." });
+        try t.expect(std.mem.endsWith(u32, r.request.prompt, &.{ 256, 257 }));
+        try t.expectEqual(@as(usize, 8), r.committed);
+        try t.expect(r.request.structure == null);
+        try t.expectEqualStrings("Answer.", r.got.content.items);
+        try t.expectEqualStrings("", r.got.reasoning.items);
+    }
+}
+
+test "Inkling Mini off: on and other Inkling checkpoints keep their prompt and reasoning path" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    for ([_]bool{ false, true }) |stream| for ([_]bool{ false, true }) |mini| {
+        const r = try run(arena.allocator(), mini, stream, false, if (mini) "" else off, &.{ "<|message_model|>", "<|content_thinking|>", "Consider.", "<|end_message|>", "<|message_model|>", "<|content_text|>", "Answer.", "<|end_message|>" });
+        try t.expectEqualSlices(u32, &.{ 'p', 'r', 'o', 'm', 'p', 't' }, r.request.prompt);
+        try t.expectEqual(@as(usize, 0), r.request.eos.len);
+        try t.expectEqualStrings("Consider.", r.got.reasoning.items);
+        try t.expectEqualStrings("Answer.", r.got.content.items);
+    };
+}
+
+test "Inkling Mini off: off wins over ignore_eos, raw and on retain caller termination control" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    for ([_]bool{ false, true }) |stream| {
+        const raw = try run(arena.allocator(), true, stream, true, off ++ ",\"ignore_eos\":true", &.{ "A", "<|end_message|>", "B" });
+        try t.expectEqual(@as(usize, 3), raw.committed);
+        try t.expectEqual(@as(usize, 0), raw.request.eos.len);
+        try t.expectEqualStrings("A<|end_message|>B", raw.got.content.items);
+        try t.expectEqualSlices(u32, &.{ 'r', 'a', 'w' }, raw.request.prompt);
+        const on = try run(arena.allocator(), true, stream, false, ",\"ignore_eos\":true", &.{ "A", "<|end_message|>", "B" });
+        try t.expectEqual(@as(usize, 3), on.committed);
+        try t.expectEqual(@as(usize, 0), on.request.eos.len);
+        const disabled = try run(arena.allocator(), true, stream, false, off ++ ",\"ignore_eos\":true", &.{ "A", "<|end_message|>", "<|message_model|>", "<|content_thinking|>", "Plan." });
+        try t.expectEqual(@as(usize, 2), disabled.committed);
+        try t.expectEqualStrings("A", disabled.got.content.items);
+        try t.expectEqualStrings("", disabled.got.reasoning.items);
+        try t.expect(disabled.request.structure == null);
+    }
+}
+
+test "Inkling Mini off: real tokenizer effort precedence and finite JSON/tool grammars" {
+    const dir_c = std.c.getenv("TF_INKLING_TEST_DIR") orelse return error.SkipZigTest;
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const dir = std.mem.span(dir_c);
+    var problem: []const u8 = "";
+    const hf = try @import("hf_text.zig").HfText.load(a, t.io, dir, null, a, &problem);
+    defer hf.deinit();
+    try t.expect(hf.text().inkling2_mini);
+    var backend: Backend = .{ .tokens = &.{} };
+    const srv = try server.Server.init(t.allocator, t.io, backend.engine(), hf.text(), .{ .served_name = "unrelated-alias", .model_ids = &.{"unrelated-alias"}, .model_dir = dir, .enable_thinking = true }, null);
+    defer srv.deinit();
+    srv.info.structures = true;
+    const msgs = (try json.parse(a, "[{\"role\":\"user\",\"content\":\"Reply briefly.\"}]")).ok;
+    const offered = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\",\"parameters\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"}},\"required\":[\"id\"],\"additionalProperties\":false}}}]")).ok.array;
+    var cx: @import("errors.zig").Cx = .{ .a = a, .named_effort = "high" };
+    const high_off = try @import("prompt.zig").renderIds(srv, &cx, msgs, &.{}, false, "high", true);
+    cx.named_effort = "none";
+    const none_off = try @import("prompt.zig").renderIds(srv, &cx, msgs, &.{}, false, "none", true);
+    try t.expectEqualSlices(u32, none_off, high_off);
+    try t.expect(std.mem.endsWith(u32, high_off, &.{ 200001, 200004 }));
+    const high_on = try @import("prompt.zig").renderIds(srv, &cx, msgs, &.{}, true, "high", true);
+    try t.expect(!std.mem.endsWith(u32, high_on, &.{ 200001, 200004 }));
+    const RawGone = struct {
+        pub fn check(_: @This()) bool {
+            return false;
+        }
+    };
+    const raw_fields = (try json.parse(a, "{\"enable_thinking\":false,\"reasoning_effort\":\"high\",\"ignore_eos\":true}")).ok;
+    const raw = try @import("chat.zig").prepare(srv, &cx, .{ .prompt = .{ .ids = &.{1} }, .fields = raw_fields, .max_tokens = 10 }, RawGone{});
+    defer srv.release(raw.preparing, raw.request);
