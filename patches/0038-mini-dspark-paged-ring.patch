new file mode 100644
index 0000000..875dcc1
--- /dev/null
+++ b/zig/src/families/inkling2/mini_stash.zig
@@ -0,0 +1,99 @@
+//! The drafters' stash: device room (TF_INKLING2_DRAFT_STASH_MIB, allocated at load so the stream budget counts it)
+//! for released streams' drafting contexts, so a prompt resumed from the target's prompt cache finds its context after
+//! its slot was reused. One stash serves the combined drafter's two (DFlash 2 and DSpark): entries go round a ring, a
+//! new one drops the entries whose room it takes, whichever drafter stashed them; each drafter keeps its own index
+//! (tokens, rows) and asks the stash whether an entry's room still holds it.
+const std = @import("std");
+
+/// TF_INKLING2_DRAFT_STASH_MIB: the stash's device MiB (default 512: ~38 DSpark contexts at their ~13.5 MiB most, or
+/// ~70 DFlash 2 contexts of 1.5K tokens at 4.6 KB a row); 0: none, only a still-free slot's context.
+pub fn bytesFromEnv() usize {
+    const v = std.c.getenv("TF_INKLING2_DRAFT_STASH_MIB") orelse return default_mib << 20;
+    const n = std.fmt.parseInt(usize, std.mem.trim(u8, std.mem.span(v), " \t\r\n"), 10) catch return default_mib << 20;
+    return n << 20;
+}
+pub const default_mib = 512;
+
+/// An entry's room: `bytes` at `off` from the stash's base, `id` while it holds them.
+pub const Span = struct { off: usize, bytes: usize, id: u64 };
+
+pub const Arena = struct {
+    base: u64 = 0, // device address (0: no stash)
+    cap: usize = 0,
+    at: usize = 0, // where the next entry goes
+    next: u64 = 1,
+    live: std.ArrayList(Span) = .empty,
+
+    pub fn deinit(a: *Arena, gpa: std.mem.Allocator) void {
+        a.live.deinit(gpa);
+    }
+
+    pub fn on(a: *const Arena) bool {
+        return a.cap > 0;
+    }
+
+    /// Room for `bytes` at the ring's next place; the entries it overlaps are dropped. null: no stash, or larger than it.
+    pub fn take(a: *Arena, gpa: std.mem.Allocator, bytes: usize) !?Span {
+        if (bytes == 0 or bytes > a.cap) return null;
+        try a.live.ensureUnusedCapacity(gpa, 1);
+        if (a.at + bytes > a.cap) a.at = 0;
+        const off = a.at;
+        var i: usize = 0;
+        while (i < a.live.items.len) {
+            const e = a.live.items[i];
+            if (e.off < off + bytes and off < e.off + e.bytes) {
+                _ = a.live.swapRemove(i);
+            } else i += 1;
+        }
+        const sp: Span = .{ .off = off, .bytes = bytes, .id = a.next };
+        a.live.appendAssumeCapacity(sp);
+        a.next += 1;
+        a.at = off + bytes;
+        return sp;
+    }
+
+    /// Whether entry `id`'s room still holds it.
+    pub fn holds(a: *const Arena, id: u64) bool {
+        for (a.live.items) |e| if (e.id == id) return true;
+        return false;
+    }
+
+    /// Entry `id` gives its room back (a drafter dropped it).
+    pub fn drop(a: *Arena, id: u64) void {
+        for (a.live.items, 0..) |e, i| if (e.id == id) {
+            _ = a.live.swapRemove(i);
+            return;
+        };
+    }
+
+    pub fn heldBytes(a: *const Arena) usize {
+        var n: usize = 0;
+        for (a.live.items) |e| n += e.bytes;
+        return n;
+    }
+};
+
+test "the stash is a ring: a new entry drops the ones whose room it takes, whoever stashed them" {
+    const gpa = std.testing.allocator;
+    var a: Arena = .{ .base = 1 << 20, .cap = 100 };
+    defer a.deinit(gpa);
+    const e1 = (try a.take(gpa, 40)).?;
+    const e2 = (try a.take(gpa, 40)).?;
+    try std.testing.expectEqual(@as(usize, 0), e1.off);
+    try std.testing.expectEqual(@as(usize, 40), e2.off);
+    try std.testing.expect(a.holds(e1.id) and a.holds(e2.id));
+    // 30 more do not fit past 80: back to 0, over e1 only
+    const e3 = (try a.take(gpa, 30)).?;
+    try std.testing.expectEqual(@as(usize, 0), e3.off);
+    try std.testing.expect(!a.holds(e1.id) and a.holds(e2.id) and a.holds(e3.id));
+    // 20 at 30..50 overlaps e2 (40..80)
+    const e4 = (try a.take(gpa, 20)).?;
+    try std.testing.expect(!a.holds(e2.id) and a.holds(e3.id) and a.holds(e4.id));
+    try std.testing.expectEqual(@as(usize, 50), a.heldBytes());
+    a.drop(e3.id);
+    try std.testing.expect(!a.holds(e3.id));
+    try std.testing.expectEqual(@as(?Span, null), try a.take(gpa, 101));
+    var none: Arena = .{};
+    try std.testing.expectEqual(@as(?Span, null), try none.take(gpa, 1));
+    try std.testing.expect(!none.on());
+}
