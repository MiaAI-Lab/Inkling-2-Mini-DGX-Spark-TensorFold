+/// TENSORFOLD_PREFILL_SHORT_BURST: the most short prompts begun back to back in a visit while streams decode (default
+/// the lane count): a lower burst lets the decoders' round, and the first visible tokens of the prompts already in,
+/// come sooner, at a longer fill phase.
+pub fn shortBurst(lanes: usize) usize {
+    const S = struct {
+        var v: ?usize = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TENSORFOLD_PREFILL_SHORT_BURST")) |t| (std.fmt.parseInt(usize, std.mem.trim(u8, std.mem.span(t), " \t"), 10) catch 0) else 0;
+    return if (S.v.? > 0) @min(S.v.?, lanes) else lanes;
+}
+
+/// TENSORFOLD_PREFILL_SHORT_ROWS: the most rows a prompt has left to fill and still go whole, back to back with the
+/// other short ones (a lane count of them a visit) before the next decode round; default `Share.short_rows`.
+/// Longer prompts take one call a visit between decode rounds.
+pub fn shortRows() u64 {
+    const S = struct {
+        var v: ?u64 = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TENSORFOLD_PREFILL_SHORT_ROWS")) |t| (std.fmt.parseInt(u32, std.mem.trim(u8, std.mem.span(t), " \t"), 10) catch Share.short_rows) else Share.short_rows;
+    return S.v.?;
 }
 
