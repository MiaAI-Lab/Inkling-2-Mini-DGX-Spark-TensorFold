+/// Where a resumed prompt's drafting context came from: its slot's kept context, the stash, or none (the rows the
+/// stream absorbs from its resume point on).
+const Resume = enum { slot, stash, cold };
+
+/// TF_INKLING2_RESUME_TRACE=1: a line a resumed prompt (where its context came from, the counts so far).
+fn resumeTrace() bool {
+    const S = struct {
