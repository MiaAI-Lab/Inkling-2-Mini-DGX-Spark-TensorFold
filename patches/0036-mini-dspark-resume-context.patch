+test "a stash entry is superseded only by one that still holds every row it gives" {
+    var toks: [1700]u32 = undefined;
+    for (&toks, 0..) |*t, i| t.* = @intCast(i);
+    // turn 1 kept rows [0, 1000); turn 2 resumed it and ran to 1600, its rings holding [456, 1600) only
+    try std.testing.expectEqual(@as(u64, 0), keptFrom(0, 1000));
+    try std.testing.expectEqual(@as(u64, 456), keptFrom(0, 1600));
+    try std.testing.expect(!supersedes(keptFrom(0, 1000), 1000, toks[0..1000], keptFrom(0, 1600), 1600, toks[0..1600]));
+    // turn 3 to 1700 holds [556, 1700): not turn 2's [456, 1600) either; the same context kept again does
+    try std.testing.expect(!supersedes(456, 1600, toks[0..1600], keptFrom(0, 1700), 1700, toks[0..1700]));
+    try std.testing.expect(supersedes(456, 1600, toks[0..1600], 456, 1600, toks[0..1600]));
+    // short contexts inside the rings: the longer one holds the shorter one's rows
+    try std.testing.expect(supersedes(0, 300, toks[0..300], keptFrom(0, 900), 900, toks[0..900]));
+    // a different prompt never supersedes
+    var other = toks;
+    other[10] = 99999;
+    try std.testing.expect(!supersedes(0, 300, toks[0..300], 0, 900, other[0..900]));
