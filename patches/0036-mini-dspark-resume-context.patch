+/// TF_INKLING2_DRAFT_STASH_MIB: device MiB (allocated at load, so the stream budget counts them) for released
+/// streams' contexts copied out of their slots, so a resumed prompt finds its context after its slot was reused
+/// (default 512, ~36 contexts of 1.2K tokens, about as many prompts as a 7-8 GiB prompt cache keeps; 0: none, only a
+/// still-free slot's).
+fn stashBytes() usize {
+    const v = std.c.getenv("TF_INKLING2_DRAFT_STASH_MIB") orelse return 512 << 20;
+    const n = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return 512 << 20;
+    return n << 20;
