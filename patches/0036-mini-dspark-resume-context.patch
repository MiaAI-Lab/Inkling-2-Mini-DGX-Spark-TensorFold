+    tokens: std.ArrayList(u32) = .empty,
+    from: u64,
+    end: u64,
+    off: usize,
+    bytes: usize,
+    order: u64,
+};
+
+fn ringBytes() usize {
+    return local_ring * kv_width * 2;
+}
+
+fn stashSize(from: u64, end: u64) usize {
+    return 4 * ringBytes() + 2 * @as(usize, @intCast(end - from)) * kv_width * 2;
+}
+
+/// The first row a context kept through `end` (absorbed from `from`) still holds in its sliding rings: its last hold
+/// wrote a block past `end`, over the ring's oldest rows.
+fn keptFrom(from: u64, end: u64) u64 {
+    return @max(from, (end + block) -| local_ring);
+}
+
+/// Whether a stash entry (kept rows [old_from, old_end) of `old_tokens`) is redundant beside a new one kept from
+/// `from` to `end`: the new one holds every row the old one gives (from its kept start, not the absorbed one; a
+/// longer turn's rings no longer hold an earlier turn's first rows) and continues its tokens.
+fn supersedes(old_from: u64, old_end: u64, old_tokens: []const u32, from: u64, end: u64, tokens: []const u32) bool {
+    return old_from >= from and old_end <= end and old_tokens.len <= tokens.len and std.mem.eql(u32, old_tokens, tokens[0..old_tokens.len]);
+}
