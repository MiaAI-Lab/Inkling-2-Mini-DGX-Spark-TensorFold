+
+/// A window's draft rows by depth into the stream's counters: each row offered at its depth (a chain's row r at r, a
+/// tree's by its parents), and the kept path's rows at depths 1 to `kept`.
+pub fn countDepths(s: *Stream, parents: []const i32, rows: usize, kept: usize) void {
+    const last = Stream.depth_slots - 1;
+    for (1..rows) |r| s.depth_offered[@min(rowDepth(parents, r), Stream.depth_slots) - 1] += 1;
+    for (1..kept + 1) |d| s.depth_accepted[@min(d - 1, last)] += 1;
+}
+
+fn rowDepth(parents: []const i32, r: usize) usize {
+    if (parents.len <= r) return r; // a chain
+    var d: usize = 0;
+    var at: i32 = @intCast(r);
+    while (at > 0 and d < parents.len) : (d += 1) at = parents[@intCast(at)];
+    return @max(d, 1);
+}
+
+test "per-depth draft counters: a chain's rows by position, a tree's by its parents, sums match drafted and kept" {
+    var s = try Stream.init(std.testing.allocator, .{ .id = "depths", .prompt = &.{ 1, 2 }, .max_new = 8 });
+    defer s.deinit(std.testing.allocator);
+    countDepths(&s, &.{}, 5, 2); // a chain of 4 drafts, 2 kept
+    countDepths(&s, &.{ -1, 0, 1, 1 }, 4, 1); // a tree: rows 2 and 3 both at depth 2
+    try std.testing.expectEqualSlices(u32, &.{ 2, 3, 1, 1 }, s.depth_offered[0..4]);
+    try std.testing.expectEqualSlices(u32, &.{ 2, 1, 0, 0 }, s.depth_accepted[0..4]);
+    var off: u32 = 0;
+    for (s.depth_offered) |v| off += v;
+    try std.testing.expectEqual(@as(u32, 7), off);
+}
