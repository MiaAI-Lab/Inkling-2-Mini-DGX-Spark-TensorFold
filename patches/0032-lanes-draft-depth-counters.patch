+/// Depths the per-depth draft counters keep apart (the engine's).
+const depth_slots = @import("engine_api").Stats.depth_slots;
+
+/// A counter by draft position, positions 0 through the deepest offered (at least 0 to 6, DSpark's block).
+fn depthFamily(w: *std.Io.Writer, name: []const u8, help: []const u8, values: *const [depth_slots]u64, offered: *const [depth_slots]u64) !void {
+    try family(w, name, "counter", help);
+    var deepest: usize = 7;
+    for (offered, 0..) |v, i| if (v > 0) {
+        deepest = @max(deepest, i + 1);
+    };
+    for (values[0..deepest], 0..) |v, i| try w.print("{s}{s}{{position=\"{d}\"}} {d}\n", .{ prefix, name, i, v });
+}
