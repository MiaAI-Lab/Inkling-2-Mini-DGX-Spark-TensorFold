diff --git a/zig/kernels/cuda/inkling2/dflash2.cu b/zig/kernels/cuda/inkling2/dflash2.cu
new file mode 100644
index 0000000..1ba255f
--- /dev/null
+++ b/zig/kernels/cuda/inkling2/dflash2.cu
@@ -0,0 +1,259 @@
+// Inkling 2 Mini's DFlash2 drafter (incoai/Inkling-2-Mini-DFlash2) past the DSpark kernels it shares (mtp.cu: RoPE'd
+// context and block keys, resnorm, merge, SwiGLU, FP8 repacks): two-tap dynamic convolutions, the windowed block
+// attention, top 16 of the target head's rows and the selector walk. Math: the model card's SGLang drafter and vLLM's
+// DFlash2; the layouts follow muse_spark/dflash2.cu and the Metal drafter (#4917).
+#include <cstdint>
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+#include "common/reduce.cuh"
+
+namespace ink2d {
+
+constexpr int kD = 128;
+constexpr int kBlock = 8;
+constexpr int kMaxQ = 32;  // a key head's query rows in a block: 8 rows x 4 heads
+constexpr int kKT = 32;
+constexpr int kChunk = 1024;
+constexpr int kTop = 16;
+
+__device__ __forceinline__ float bf(uint16_t u) { return __uint_as_float(static_cast<uint32_t>(u) << 16); }
+__device__ __forceinline__ uint16_t tobf(float f) { return __bfloat16_as_ushort(__float2bfloat16_rn(f)); }
+__device__ __forceinline__ bool beats(float va, int ia, float vb, int ib) { return va > vb || (va == vb && ia < ib); }
+
+// mtp.cu's DraftKey and keyed uniform (sample.cu's, bit for bit)
+struct DraftKey {
+    unsigned long long seed;
+    float inv_t; // 0: greedy drafts
+    unsigned pos;
+};
+__device__ __forceinline__ unsigned long long kmix(unsigned long long x) {
+    x ^= x >> 30;
+    x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 27;
+    x *= 0x94D049BB133111EBull;
+    return x ^ (x >> 31);
+}
+__device__ __forceinline__ float race_u(unsigned long long seed, unsigned pos, unsigned id) {
+    unsigned long long x = kmix(seed + 0x9E3779B97F4A7C15ull);
+    x = kmix(x ^ (static_cast<unsigned long long>(pos) * 0xD1B54A32D192ED03ull));
+    x = kmix(x ^ static_cast<unsigned long long>(id));
+    const float u = (static_cast<float>(static_cast<unsigned>(x >> 40)) + 0.5f) * (1.0f / 16777216.0f);
+    return fminf(u, __uint_as_float(0x3F7FFFFFu));
+}
+
+}  // namespace ink2d
+
+// Y[r, c] = sum_t (base[side, t, c] + dyn[r, side, t, c / group]) * X[r - t, c] within r's 8-row block, t in {0, 1}:
+// fp32 sums, one bf16 round. dyn bf16 [rows][2][2][groups]. Not in place. Block a row.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2d_conv(const uint16_t* __restrict__ X, const uint16_t* __restrict__ dyn,
+                                                                const uint16_t* __restrict__ base, uint16_t* __restrict__ Y, int C,
+                                                                int group, int side) {
+    using namespace ink2d;
+    const size_t r = blockIdx.x;
+    const int groups = C / group;
+    const bool prev = r % kBlock != 0;
+    const uint16_t* d = dyn + r * 4 * groups + side * 2 * groups;
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        const int g = c / group;
+        float y = (bf(base[side * 2 * C + c]) + bf(d[g])) * bf(X[r * C + c]);
+        if (prev) y += (bf(base[(side * 2 + 1) * C + c]) + bf(d[groups + g])) * bf(X[(r - 1) * C + c]);
+        Y[r * C + c] = tobf(y);
+    }
+}
+
+struct DfAttnArgs {
+    const uint16_t* q;  // bf16 [T][hq][128]
+    const uint16_t* kc;  // bf16 [ring][hk][128]
+    const uint16_t* vc;
+    float* po;   // fp32 [chunks][T * hq][128]: unnormalised sums
+    float* pml;  // fp32 [chunks][T * hq][2]: max, total
+    int T, hq, hk, ring, lo, hi, c0, window;
+    float scale;
+};
+
+// tf_ink2m_attn at 32 query rows a key head, with a sliding window: the block's row i (position hi - T + 1 + i) sees
+// the context from its position - window + 1 on, and the whole block.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2d_attn(DfAttnArgs a) {
+    using namespace ink2d;
+    __shared__ float sq[kMaxQ][kD];
+    __shared__ uint16_t sk[kKT][kD + 8];
+    __shared__ uint16_t sv[kKT][kD];
+    __shared__ float sp[kMaxQ][kKT];
+    __shared__ float sm[kMaxQ], sl[kMaxQ], sa[kMaxQ];
+    const int j = blockIdx.y, c = a.c0 + blockIdx.x, tid = threadIdx.x;
+    const int g = a.hq / a.hk, nq = a.T * g, nqt = a.T * a.hq;
+    const int anchor = a.hi - a.T + 1;
+    const int k0 = max(a.lo, c * kChunk), k1 = min(a.hi + 1, (c + 1) * kChunk);
+    for (int idx = tid; idx < nq * kD; idx += blockDim.x) {
+        const int qi = idx / kD, d = idx % kD;
+        sq[qi][d] = bf(a.q[(static_cast<size_t>(qi / g) * a.hq + j * g + qi % g) * kD + d]);
+    }
+    for (int qi = tid; qi < nq; qi += blockDim.x) {
+        sm[qi] = -INFINITY;
+        sl[qi] = 0.0f;
+    }
+    const int d = tid & (kD - 1), half = tid >> 7;
+    float o[kMaxQ / 2];
+#pragma unroll
+    for (int r = 0; r < kMaxQ / 2; ++r) o[r] = 0.0f;
+    __syncthreads();
+    for (int kt = k0; kt < k1; kt += kKT) {
+        const int nk = min(kKT, k1 - kt);
+        for (int idx = tid; idx < nk * kD; idx += blockDim.x) {
+            const int kk = idx / kD, dd = idx % kD;
+            const size_t at = (static_cast<size_t>((kt + kk) % a.ring) * a.hk + j) * kD + dd;
+            sk[kk][dd] = a.kc[at];
+            sv[kk][dd] = a.vc[at];
+        }
+        __syncthreads();
+        for (int idx = tid; idx < nq * kKT; idx += blockDim.x) {
+            const int qi = idx / kKT, kk = idx % kKT;
+            float s = -INFINITY;
+            if (kk < nk && kt + kk > anchor + qi / g - a.window) {
+                s = 0.0f;
+                for (int dd = 0; dd < kD; ++dd) s += sq[qi][dd] * bf(sk[kk][dd]);
+                s *= a.scale;
+            }
+            sp[qi][kk] = s;
+        }
+        __syncthreads();
+        for (int qi = tid; qi < nq; qi += blockDim.x) {
+            float mx = sm[qi];
+            for (int kk = 0; kk < nk; ++kk) mx = fmaxf(mx, sp[qi][kk]);
+            float al = 0.0f, sum = 0.0f;
+            if (mx == -INFINITY) {  // every key so far is past this row's window
+                for (int kk = 0; kk < nk; ++kk) sp[qi][kk] = 0.0f;
+            } else {
+                al = expf(sm[qi] - mx);
+                for (int kk = 0; kk < nk; ++kk) {
+                    const float p = expf(sp[qi][kk] - mx);
+                    sp[qi][kk] = p;
+                    sum += p;
+                }
+            }
+            sl[qi] = sl[qi] * al + sum;
+            sm[qi] = mx;
+            sa[qi] = al;
+        }
+        __syncthreads();
+#pragma unroll
+        for (int r = 0; r < kMaxQ / 2; ++r) {
+            const int qi = half * (kMaxQ / 2) + r;
+            if (qi < nq) {
+                float acc = o[r] * sa[qi];
+                for (int kk = 0; kk < nk; ++kk) acc += sp[qi][kk] * bf(sv[kk][d]);
+                o[r] = acc;
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < kMaxQ / 2; ++r) {
+        const int qi = half * (kMaxQ / 2) + r;
+        if (qi >= nq) continue;
+        const size_t rh = static_cast<size_t>(blockIdx.x) * nqt + (qi / g) * a.hq + j * g + qi % g;
+        a.po[rh * kD + d] = o[r];
+        if (d == 0) {
+            a.pml[rh * 2] = sm[qi];
+            a.pml[rh * 2 + 1] = sl[qi];
+        }
+    }
+}
+
+// The top 16 (value descending, then id) of draft rows' raw bf16 logits: out [streams * 7][32] = 16 values, then their
+// ids as bits. head [streams * 8][V], each block's row 0 skipped. Grid (streams * 7).
+extern "C" __global__ void __launch_bounds__(256) tf_ink2d_topk(const uint16_t* __restrict__ head, int V, float* __restrict__ out) {
+    using namespace ink2d;
+    __shared__ float hv[256];
+    __shared__ int hi[256];
+    __shared__ int ht[256];
+    const int t = threadIdx.x, s = blockIdx.x / (kBlock - 1), i = blockIdx.x % (kBlock - 1);
+    const uint16_t* row = head + static_cast<size_t>(s * kBlock + 1 + i) * V;
+    float v[kTop];
+    int id[kTop];
+#pragma unroll
+    for (int k = 0; k < kTop; ++k) {
+        v[k] = -INFINITY;
+        id[k] = 0x7fffffff;
+    }
+    for (int c = t; c < V; c += 256) {
+        const float x = bf(row[c]);
+        if (!(x > v[kTop - 1])) continue;  // a thread's ids ascend: a tie loses; NaN is never a candidate
+        int k = kTop - 1;
+        while (k > 0 && x > v[k - 1]) {
+            v[k] = v[k - 1];
+            id[k] = id[k - 1];
+            --k;
+        }
+        v[k] = x;
+        id[k] = c;
+    }
+    float* o = out + static_cast<size_t>(blockIdx.x) * 2 * kTop;
+    int ptr = 0;
+    for (int pick = 0; pick < kTop; ++pick) {
+        hv[t] = ptr < kTop ? v[ptr] : -INFINITY;
+        hi[t] = ptr < kTop ? id[ptr] : 0x7fffffff;
+        ht[t] = t;
+        __syncthreads();
+        for (int h = 128; h > 0; h >>= 1) {
+            if (t < h && beats(hv[t + h], hi[t + h], hv[t], hi[t])) {
+                hv[t] = hv[t + h];
+                hi[t] = hi[t + h];
+                ht[t] = ht[t + h];
+            }
+            __syncthreads();
+        }
+        if (t == 0) {
+            o[pick] = hv[0];
+            o[kTop + pick] = __int_as_float(hi[0]);
+        }
+        const int won = ht[0];
+        __syncthreads();
+        if (t == won) ++ptr;
+    }
+}
+
+// The selector: walk[1 + i] = the best of position i's candidates by cap * tanh((unary + edge) / cap), edge =
+// sum_r pred[prev][r] * hid[i][r] * succ[cand][r]; a sampled stream's scores race with the target's own noise. 512
+// threads: a warp a candidate. A block a stream.
+extern "C" __global__ void __launch_bounds__(512) tf_ink2d_walk(const float* __restrict__ top, const uint16_t* __restrict__ hid, int R,
+                                                                const uint16_t* __restrict__ pred, const uint16_t* __restrict__ succ,
+                                                                float cap, int n, const ink2d::DraftKey* __restrict__ keys,
+                                                                int* __restrict__ walk) {
+    using namespace ink2d;
+    __shared__ float sc[kTop];
+    __shared__ int prev;
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    if (threadIdx.x == 0) prev = walk[0];
+    __syncthreads();
+    for (int i = 0; i < n; ++i) {
+        const float* row = top + static_cast<size_t>(i) * 2 * kTop;
+        const int c = __float_as_int(row[kTop + warp]);
+        const bool live = c != 0x7fffffff;
+        const uint16_t* h = hid + static_cast<size_t>(1 + i) * R;
+        float acc = 0.0f;
+        if (live)
+            for (int r = lane; r < R; r += 32) acc += bf(pred[static_cast<size_t>(prev) * R + r]) * bf(h[r]) * bf(succ[static_cast<size_t>(c) * R + r]);
+        acc = tf_common::warp_sum(acc);
+        if (lane == 0) {
+            float s = -INFINITY;
+            if (live) {
+                s = tanhf((row[warp] + acc) / cap) * cap;
+                if (keys != nullptr && keys->inv_t > 0.0f)
+                    s = s * keys->inv_t - logf(-logf(race_u(keys->seed, keys->pos + static_cast<unsigned>(i), static_cast<unsigned>(c))));
+            }
+            sc[warp] = s;
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            int best = 0;
+            for (int k = 1; k < kTop; ++k)
+                if (sc[k] > sc[best]) best = k;
+            const int id = __float_as_int(row[kTop + best]);
+            prev = id == 0x7fffffff ? 0 : id;
+            walk[1 + i] = prev;
+        }
+        __syncthreads();
+    }
+}
