 /// The first drafts' depth for `reach`.
 pub fn firstDepth(e: *Engine, s: *Stream, reach: Reach) !u32 {
+    // lone chances: a stream's first drafts are sized as without chances (its drafter may not price it yet)
+    if (try e.ensureLone()) {
+        const was = e.chance_step;
+        e.setChances(false);
