@@ -0,0 +1,231 @@
+//! Inkling 2 Mini's two drafters behind one (TF_INKLING2_DSPARK_DIR with a DFlash2 --drafter): DFlash2 for prompts
+//! shorter than a limit, DSpark from there on. DFlash2's layers see the last 2,048 rows only, while DSpark's global
+//! layer sees the whole context, so DSpark drafts long grounded prompts better. A stream keeps the drafter it opened
+//! with; both read the same taps. A prompt resumed from the prompt cache opens on the drafter that holds its context
+//! when only the other one does (DFlash2's kept rings, DSpark's kept slots and stash): a conversation that began below
+//! the limit and grew past it keeps DFlash2 up to TF_INKLING2_DFLASH2_FOLLOW_MAX prompt tokens, and a short prompt whose
+//! cached prefix only DSpark drafted takes DSpark; either way the resumed rows are not drafted cold.
+const std = @import("std");
+const lanes = @import("lanes");
+const dspark = @import("mini_dspark.zig");
+const dflash = @import("mini_dflash.zig");
+
+const dr = lanes.drafter;
+const Stream = lanes.Stream;
+
+/// TF_INKLING2_DFLASH2_MAX_PROMPT: prompts of at least this many tokens draft with DSpark.
+pub fn limitFromEnv() usize {
+    const v = std.c.getenv("TF_INKLING2_DFLASH2_MAX_PROMPT") orelse return default_limit;
+    return std.fmt.parseInt(usize, std.mem.trim(u8, std.mem.span(v), " \t\r\n"), 10) catch default_limit;
+}
+pub const default_limit = 2048;
+
+/// TF_INKLING2_DFLASH2_FOLLOW_MAX: a resumed prompt whose context only DFlash 2 holds drafts with DFlash 2 below this
+/// many prompt tokens (default twice the limit; 0: never at or past the limit). Past it, DSpark takes over and drafts
+/// the resumed rows cold once (from ~4K tokens DSpark drafts grounded tasks far better).
+pub fn followFromEnv(limit: usize) usize {
+    const v = std.c.getenv("TF_INKLING2_DFLASH2_FOLLOW_MAX") orelse return 2 * limit;
+    return std.fmt.parseInt(usize, std.mem.trim(u8, std.mem.span(v), " \t\r\n"), 10) catch 2 * limit;
+}
+
+/// Which drafter a stream opens on, and why.
+pub const Route = enum {
+    short, // below the limit: DFlash 2
+    long, // at or past it: DSpark
+    follow_df, // resumed past the limit, its context only in DFlash 2 (below the follow limit)
+    follow_ds, // resumed below the limit, its context only in DSpark
+
+    pub fn dflash2(r: Route) bool {
+        return r == .short or r == .follow_df;
+    }
+};
+
+/// The drafter for a prompt of `prompt_len` tokens resumed at `start` (0: not resumed); `df_has` / `ds_has`: whether
+/// each holds the resumed rows' context.
+pub fn routeOf(limit: usize, follow: usize, prompt_len: usize, start: u64, df_has: bool, ds_has: bool) Route {
+    if (prompt_len < limit) return if (start > 0 and ds_has and !df_has) .follow_ds else .short;
+    return if (start > 0 and prompt_len < follow and df_has and !ds_has) .follow_df else .long;
+}
+
+const max_items = 64;
+
+pub const Hybrid = struct {
+    gpa: std.mem.Allocator,
+    ds: *dspark.Drafter,
+    df: *dflash.Drafter,
+    limit: usize,
+    follow: usize, // followFromEnv
+    short: std.AutoHashMapUnmanaged(*Stream, bool) = .empty, // true: the stream drafts with DFlash 2
+    routes: [4]u64 = @splat(0), // opened streams by Route
+
+    pub fn init(gpa: std.mem.Allocator, ds: *dspark.Drafter, df: *dflash.Drafter, limit: usize) !*Hybrid {
+        const h = try gpa.create(Hybrid);
+        h.* = .{ .gpa = gpa, .ds = ds, .df = df, .limit = limit, .follow = followFromEnv(limit) };
+        return h;
+    }
+
+    pub fn deinit(h: *Hybrid) void {
+        h.short.deinit(h.gpa);
+        h.df.deinit();
+        h.ds.deinit();
+        h.gpa.destroy(h);
+    }
+
+    pub fn fixedBytes(h: *const Hybrid) usize {
+        return h.ds.fixedBytes() + h.df.fixedBytes();
+    }
+
+    pub fn reserve(h: *Hybrid, streams: u32) !void {
+        try h.ds.reserve(streams);
+        try h.df.reserve(streams);
+    }
+
+    pub fn drafter(h: *Hybrid) dr.Drafter {
+        return .{ .kind = "DFlash2+DSpark", .ptr = h, .vtable = &.{ .taps = tapsFn, .facts = factsFn, .open = openFn, .absorb = absorbFn, .hold = holdFn, .held = heldFn, .release = releaseFn, .chances = chancesFn } };
+    }
+
+    fn self(ptr: *anyopaque) *Hybrid {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn tapsFn(_: *anyopaque) []const u32 {
+        return &dspark.taps;
+    }
+
+    /// DSpark's facts (its hold prices), with a stream's bytes for both drafters' caches; with DFlash 2's chances on
+    /// (TF_INKLING2_DFLASH2_CHANCES=1) its chance facts too: a DFlash 2 stream alone prices its drafts by them, every
+    /// other stream (DSpark's, or any in a shared round) gives none and keeps the per-depth rates.
+    fn factsFn(ptr: *anyopaque) dr.Facts {
+        const h = self(ptr);
+        var f = h.ds.drafter().facts();
+        const g = h.df.drafter().facts();
+        f.stream_bytes += g.stream_bytes;
+        if (g.chances) {
+            f.chances = true;
+            f.slack = g.slack;
+            f.confidence_floor = g.confidence_floor;
+            f.chances_lone = !h.df.chances_shared; // chances (and their slack) only for a lone DFlash2 stream's steps
+        }
+        return f;
+    }
+
+    /// DFlash 2's chances for its stream when no other stream (of either drafter) is open, unless shared chances are on.
+    fn chancesFn(ptr: *anyopaque, s: *Stream, out: []f64) anyerror!bool {
+        const h = self(ptr);
+        const short = h.short.get(s) orelse return false;
+        if (!short) return false;
+        if (h.short.count() > 1 and !h.df.chances_shared) return false;
+        return h.df.drafter().chances(s, out);
+    }
+
+    fn isShort(h: *const Hybrid, s: *Stream) !bool {
+        return h.short.get(s) orelse error.DraftStreamUnknown;
+    }
+
+    /// The stream's drafter (routeOf). The lanes open a drafter after the target's first prompt step, its restore
+    /// from the prompt cache done: s.cached is where the stream resumed.
+    fn openFn(ptr: *anyopaque, s: *Stream) anyerror!void {
+        const h = self(ptr);
+        const start: u64 = s.cached;
+        const r = if (start == 0) routeOf(h.limit, h.follow, s.prompt_len, 0, false, false) else routeOf(h.limit, h.follow, s.prompt_len, start, h.df.holdsContext(s, start), h.ds.holdsContext(s, start));
+        const use_df = r.dflash2();
+        h.routes[@intFromEnum(r)] += 1;
+        // TF_INKLING2_RESUME_TRACE=1: every stream's drafter (which drafter served a request, for the gates)
+        if (dspark.resumeTrace()) std.log.info("Inkling 2 Mini drafters: stream {s} prompt {d} resumed at {d}: {s} ({s}); routes short {d}, long {d}, follow_df {d}, follow_ds {d}", .{ s.id, s.prompt_len, start, if (use_df) "DFlash 2" else "DSpark", @tagName(r), h.routes[0], h.routes[1], h.routes[2], h.routes[3] });
+        try h.short.ensureUnusedCapacity(h.gpa, 1); // before the child opens: no slot left open on a failed put
+        if (use_df) try h.df.drafter().open(s) else try h.ds.drafter().open(s);
+        h.short.putAssumeCapacity(s, use_df);
+    }
+
+    fn releaseFn(ptr: *anyopaque, s: *Stream) void {
+        const h = self(ptr);
+        const e = h.short.fetchRemove(s) orelse return;
+        if (e.value) h.df.drafter().release(s) else h.ds.drafter().release(s);
+    }
+
+    fn absorbFn(ptr: *anyopaque, items: []const dr.Absorb) anyerror!void {
+        const h = self(ptr);
+        if (items.len > max_items) return error.DraftTooManyItems;
+        var a: [max_items]dr.Absorb = undefined;
+        var b: [max_items]dr.Absorb = undefined;
+        var na: usize = 0;
+        var nb: usize = 0;
+        for (items) |it| {
+            if (try h.isShort(it.stream)) {
+                a[na] = it;
+                na += 1;
+            } else {
+                b[nb] = it;
+                nb += 1;
+            }
+        }
+        if (na > 0) try h.df.drafter().absorb(a[0..na]);
+        if (nb > 0) try h.ds.drafter().absorb(b[0..nb]);
+    }
+
+    fn holdFn(ptr: *anyopaque, items: []const dr.Hold) anyerror!void {
+        const h = self(ptr);
+        if (items.len > max_items) return error.DraftTooManyItems;
+        var a: [max_items]dr.Hold = undefined;
+        var b: [max_items]dr.Hold = undefined;
+        var na: usize = 0;
+        var nb: usize = 0;
+        for (items) |it| {
+            if (try h.isShort(it.stream)) {
+                a[na] = it;
+                na += 1;
+            } else {
+                b[nb] = it;
+                nb += 1;
+            }
+        }
+        if (na > 0) try h.df.drafter().hold(a[0..na]);
+        if (nb > 0) try h.ds.drafter().hold(b[0..nb]);
+    }
+
+    /// Each drafter's streams in one call (one stream sync each, not one a stream).
+    fn heldFn(ptr: *anyopaque, streams: []const *Stream, out: []const []u32) anyerror!void {
+        const h = self(ptr);
+        if (streams.len > max_items) return error.DraftTooManyItems;
+        var as: [max_items]*Stream = undefined;
+        var ao: [max_items][]u32 = undefined;
+        var bs: [max_items]*Stream = undefined;
+        var bo: [max_items][]u32 = undefined;
+        var na: usize = 0;
+        var nb: usize = 0;
+        for (streams, out) |s, o| {
+            if (try h.isShort(s)) {
+                as[na] = s;
+                ao[na] = o;
+                na += 1;
+            } else {
+                bs[nb] = s;
+                bo[nb] = o;
+                nb += 1;
+            }
+        }
+        if (na > 0) try h.df.drafter().held(as[0..na], ao[0..na]);
+        if (nb > 0) try h.ds.drafter().held(bs[0..nb], bo[0..nb]);
+    }
+};
+
+test "a resumed prompt follows the drafter that holds its context, DFlash 2 only below the follow limit" {
+    const t = std.testing;
+    // not resumed, or both / neither hold it: the limit decides
+    try t.expectEqual(Route.short, routeOf(2048, 4096, 1500, 0, false, true));
+    try t.expectEqual(Route.long, routeOf(2048, 4096, 2300, 0, true, false));
+    try t.expectEqual(Route.short, routeOf(2048, 4096, 1500, 1200, true, true));
+    try t.expectEqual(Route.long, routeOf(2048, 4096, 2300, 2200, false, false));
+    // a conversation that grew past the limit keeps DFlash 2 while only it holds the context, below the follow limit
+    try t.expectEqual(Route.follow_df, routeOf(2048, 4096, 2300, 2200, true, false));
+    try t.expectEqual(Route.long, routeOf(2048, 4096, 4096, 4000, true, false));
+    try t.expectEqual(Route.long, routeOf(2048, 0, 2300, 2200, true, false));
+    // a turn of 3,800 tokens resumed at 1,700 (below its last window, 1,752..3,800): DFlash 2 would restore
+    // nothing, so it does not count as holding the context (holdsContext) and DSpark takes the prompt whole
+    try t.expectEqual(Route.long, routeOf(2048, 4096, 3800, 1700, dflash.windowResumes(3800, 1700), false));
+    try t.expectEqual(Route.follow_df, routeOf(2048, 4096, 3800, 1816, dflash.windowResumes(3800, 1816), false));
+    // a short prompt whose cached prefix only DSpark drafted
+    try t.expectEqual(Route.follow_ds, routeOf(2048, 4096, 1800, 1500, false, true));
+    try t.expect(Route.follow_df.dflash2() and Route.short.dflash2() and !Route.long.dflash2() and !Route.follow_ds.dflash2());
+    try t.expectEqual(@as(usize, 4096), followFromEnv(2048));
+}
