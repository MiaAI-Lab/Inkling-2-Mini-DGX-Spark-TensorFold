+/// that context instead of starting cold (proposals only; the target verifies every draft).
+fn keepOn() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TF_INKLING2_DRAFT_KEEP")) |e| e[0] != '0' else true;
+    return S.v.?;
+}
