+test "a resumed prompt takes the free slot that kept its prefix, else the oldest; a ring keeps its last window" {
+    const t = std.testing;
+    const a = t.allocator;
+    var slots: [3]Slot = .{ .{ .ring = 0, .walk = 0, .released = 2 }, .{ .ring = 0, .walk = 0, .released = 1 }, .{ .ring = 0, .walk = 0, .released = 3 } };
+    defer for (&slots) |*sl| sl.kept.deinit(a);
+    var prompt: [200]u32 = undefined;
+    for (&prompt, 0..) |*p, i| p.* = @intCast(i + 7);
+    try t.expectEqual(@as(?usize, 1), pick(&slots, &prompt, true)); // nothing kept: the oldest release
+    try slots[2].kept.appendSlice(a, prompt[0..150]);
+    slots[2].kept_end = 150;
+    try t.expectEqual(@as(?usize, 2), pick(&slots, &prompt, true));
+    try t.expectEqual(@as(?usize, 1), pick(&slots, &prompt, false)); // images, or TF_INKLING2_DRAFT_KEEP=0
+    slots[2].used = true;
+    try t.expectEqual(@as(?usize, 1), pick(&slots, &prompt, true));
+    slots[2].used = false;
+    slots[2].kept_from = 100; // the ring holds rows 100..150: a 150-row shared prefix reaches only 50 into it
+    try t.expectEqual(@as(?usize, 1), pick(&slots, &prompt, true));
+    slots[2].kept_from = 80;
+    try t.expectEqual(@as(?usize, 2), pick(&slots, &prompt, true));
+    slots[2].kept_from = 0;
+    prompt[40] = 1; // now shares 40 < keep_min tokens: not worth taking
+    try t.expectEqual(@as(?usize, 1), pick(&slots, &prompt, true));
+    for (&slots) |*sl| sl.used = true;
+    try t.expectEqual(@as(?usize, null), pick(&slots, &prompt, true));
+    try t.expectEqual(@as(u64, 0), keptFrom(0, 1500));
+    try t.expectEqual(@as(u64, 3000 - window), keptFrom(10, 3000));
+    try t.expectEqual(@as(u64, 2000), keptFrom(2000, 3000));
+}
