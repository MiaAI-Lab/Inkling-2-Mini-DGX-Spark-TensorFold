+/// The free slot whose kept context shares the longest prefix with `prompt` when `match`, else the one released longest
+/// ago; null: every slot is taken. A slot counts only when the shared prefix reaches keep_min rows into what its ring still
+/// holds, so a prompt that merely shares a system prompt does not take over a ring it cannot resume from.
+fn pick(slots: []const Slot, prompt: []const u32, match: bool) ?usize {
+    var best: ?usize = null;
+    var best_len: usize = keep_min - 1;
+    var oldest: ?usize = null;
+    for (slots, 0..) |sl, i| {
+        if (sl.used) continue;
+        if (oldest == null or sl.released < slots[oldest.?].released) oldest = i;
+        if (!match or sl.kept_end == 0) continue;
+        const n = std.mem.indexOfDiff(u32, sl.kept.items, prompt) orelse @min(sl.kept.items.len, prompt.len);
+        if (n < keptFrom(sl.kept_from, sl.kept_end) + keep_min) continue;
+        if (n > best_len) {
+            best = i;
+            best_len = n;
+        }
+    }
+    return best orelse oldest;
+}
